{
  "title": "NEMO Backend",
  "uid": "nemo-backend",
  "tags": [
    "nemo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "constant",
        "query": "nemo-backend",
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "요청",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "초당 요청 수 (엔드포인트별)",
      "description": "http_server_requests_seconds_count의 증가율. 어떤 API가 실제로 쓰이는지 본다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"nemo-backend\"}[1m]))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "응답시간 p95 (엔드포인트별)",
      "description": "느린 API를 찾는 핵심 패널. 평균은 소수의 느린 요청을 감춘다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"nemo-backend\"}[5m]))) and on (uri) (sum by (uri) (rate(http_server_requests_seconds_count{job=\"nemo-backend\"}[5m])) > 0)",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "5xx 오류율",
      "description": "전체 요청 대비 서버 오류 비율. 0이 아니면 바로 확인한다.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"nemo-backend\", status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"nemo-backend\"}[5m])), 0.0001)",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "상태 코드별 요청",
      "description": "4xx가 갑자기 늘면 클라이언트 계약이 깨졌다는 신호일 수 있다.",
      "gridPos": {
        "h": 5,
        "w": 18,
        "x": 6,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"nemo-backend\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "JVM / DB",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "JVM Heap 사용량",
      "description": "used와 committed를 함께 본다. max는 컨테이너 기본값이 크게 잡혀 있어 같이 그리면 used가 바닥에 붙어 아무것도 읽히지 않는다. 한계 대비 여유는 옆의 사용률 패널로 본다.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{job=\"nemo-backend\", area=\"heap\"})",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_committed_bytes{job=\"nemo-backend\", area=\"heap\"})",
          "legendFormat": "committed (JVM이 확보한 양)"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "DB Connection Pool (HikariCP)",
      "description": "pending이 0보다 크면 커넥션을 기다리는 요청이 있다는 뜻이다.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{job=\"nemo-backend\"}",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_idle{job=\"nemo-backend\"}",
          "legendFormat": "idle"
        },
        {
          "refId": "C",
          "expr": "hikaricp_connections_pending{job=\"nemo-backend\"}",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "GC 일시정지",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cause) (rate(jvm_gc_pause_seconds_sum{job=\"nemo-backend\"}[1m]))",
          "legendFormat": "{{cause}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Heap 사용률",
      "description": "used / max. 계속 차오르면 메모리 누수나 캐시 무한 증가를 의심한다. 바이트 그래프로는 이 추세가 안 보인다.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{job=\"nemo-backend\", area=\"heap\"}) / clamp_min(sum(jvm_memory_max_bytes{job=\"nemo-backend\", area=\"heap\"}), 1)",
          "legendFormat": "heap 사용률"
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "지도 외부 API 캐시",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 12,
      "type": "stat",
      "title": "캐시 적중률 (hit ratio)",
      "description": "hit / (hit + miss). 캐시가 실제로 일을 하고 있는지 보는 첫 번째 숫자다. 낮으면 TTL이 짧거나 요청이 매번 달라 캐시가 무의미하다는 뜻이다. Local Search 5분 / Reverse Geocoding 30분은 데이터 특성으로 정한 초기값이므로, 이 값을 보고 조정한다.",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "데이터 없음",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cache) (rate(cache_gets_total{job=\"nemo-backend\", result=\"hit\"}[5m])) / clamp_min(sum by (cache) (rate(cache_gets_total{job=\"nemo-backend\"}[5m])), 0.0001)",
          "legendFormat": "{{cache}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "캐시 hit / miss (초당)",
      "description": "miss가 곧 네이버로 나가는 외부 호출이다. 두 캐시를 따로 봐야 어느 쪽이 비용을 쓰는지 알 수 있다. 예전에는 하나의 Map이라 구분 자체가 불가능했다.",
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 8,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cache) (rate(cache_gets_total{job=\"nemo-backend\", result=\"hit\"}[5m]))",
          "legendFormat": "{{cache}} hit"
        },
        {
          "refId": "B",
          "expr": "sum by (cache) (rate(cache_gets_total{job=\"nemo-backend\", result=\"miss\"}[5m]))",
          "legendFormat": "{{cache}} miss"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "캐시 항목 수 (size)",
      "description": "maximumSize(기본 1000 entry)에 얼마나 가까운지 본다. Reverse Geocoding은 키가 좌표라서 지도를 움직이는 만큼 늘어난다. 상한에 붙으면 eviction이 시작된다. 단위는 바이트가 아니라 항목 개수다.",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cache) (cache_size{job=\"nemo-backend\"})",
          "legendFormat": "{{cache}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "캐시에서 빠진 항목 (eviction + 만료, 초당)",
      "description": "캐시에서 빠져나간 항목 수. maximumSize에 눌려 밀려난 것과 TTL이 지나 만료된 것이 함께 잡힌다(Caffeine의 evictionCount는 둘 다 센다). 크기 대비 급증하면 상한이 작다는 뜻이고, TTL이 짧은 캐시는 평상시에도 꾸준히 올라간다. cache_size와 같이 봐야 어느 쪽인지 알 수 있다.",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "0",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cache) (rate(cache_evictions_total{job=\"nemo-backend\"}[5m]))",
          "legendFormat": "{{cache}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "stat",
      "title": "캐시가 막아준 외부 호출 (5분)",
      "description": "hit 수 = 네이버로 나가지 않은 요청 수. 캐시가 없었다면 그만큼 더 나갔다는 뜻이다. 성능 개선폭이 아니라 '막아준 호출 수'를 센 값이므로 응답 속도와 혼동하지 않는다.",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cache) (increase(cache_gets_total{job=\"nemo-backend\", result=\"hit\"}[5m]))",
          "legendFormat": "{{cache}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "네이버로 실제 나간 외부 호출 (초당)",
      "description": "캐시 miss와 1:1이 아니다. 429 재시도가 붙으면 miss 1건에 호출이 여러 번 나가고, 캐시를 끄면 miss 지표 자체가 사라진다. 캐시 효과는 적중률이 아니라 '밖으로 몇 번 나갔는가'로 확인해야 하므로 호출하는 자리에서 직접 센다.",
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 0,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "0",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (api) (rate(naver_api_calls_total{job=\"nemo-backend\"}[5m]))",
          "legendFormat": "{{api}}"
        }
      ]
    }
  ]
}
